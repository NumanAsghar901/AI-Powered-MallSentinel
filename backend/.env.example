# Copy to backend/.env and fill in. Never commit .env.
APP_ENV=development

# Host name `db` works inside docker compose. Use localhost:5432 when running uvicorn on your machine.
DATABASE_URL=postgresql+asyncpg://mallsentinel:change-me@db:5432/mallsentinel
TEST_DATABASE_URL=postgresql+asyncpg://mallsentinel:change-me@db:5432/mallsentinel_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_EXPIRE_MINUTES=30


# Gmail SMTP (used for penalty notices and password-reset emails).
# 1. Turn on 2-step verification for the Gmail account.  2. Create an App Password
#    (Google Account -> Security -> App passwords).  3. Paste it below WITHOUT spaces.
# Use the App Password, never the normal account password. Leave both empty to disable email:
# penalties are still saved and the app shows "email not sent" with a Resend button.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
# Optional display name part only; Gmail always sends from SMTP_USER.
SMTP_FROM=

# Used only by `python -m app.seed`.
# Emails must use a real-looking domain: reserved ones (.local, .test, .example) are rejected by validation.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=System Administrator
SEED_DEMO_PASSWORD=
SEED_DEMO_EMAIL_DOMAIN=demo.mallsentinel.pk
